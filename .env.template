# ================================
# eInvoice Production Environment Variables
# ================================
# 
# SECURITY NOTICE:
# 1. Copy this file to .env in your production deployment
# 2. Replace all placeholder values with actual production values
# 3. Never commit .env files to version control
# 4. Ensure .env file has restricted permissions (600)
# 5. Use strong, unique values for all secrets
#
# ================================

# ================================
# NODE.JS ENVIRONMENT
# ================================
NODE_ENV=production
# Node listen port.
# Willis PM2 direct HTTPS: PORT=443 (pm2 --env willis)
# IIS reverse proxy: PORT=3000 (pm2 --env iis) — IIS binds 443 instead
PORT=3000
NODE_TLS_REJECT_UNAUTHORIZED=0

# ================================
# DEPLOYMENT MODE: PM2 DIRECT HTTPS vs IIS REVERSE PROXY
# ================================
# Two supported production setups:
#
# A) PM2 direct HTTPS — Willis (willis-einvoice.ddns.net, no IIS proxy):
#    - Node serves HTTPS on PORT=443 using SSL_* cert paths below
#    - PM2: pm2 start ecosystem.config.js --env willis
#    - Required: TRUST_PROXY=false, NODE_DIRECT_HTTPS=true, COOKIE_DOMAIN=willis-einvoice.ddns.net
#    - Stop IIS HTTPS bindings on 443 before starting (port conflict)
#    - Run PM2 as Administrator or grant urlacl for port 443
#    - Setup script: scripts\willis-pm2-setup.bat
#
# B) IIS reverse proxy (optional alternative):
#    - IIS binds HTTPS on 443, forwards HTTP to Node on 3000 (web.config)
#    - PM2: pm2 start ecosystem.config.js --env iis
#    - Required: TRUST_PROXY=true, NODE_DIRECT_HTTPS=false, PORT=3000
#
# C) Node direct HTTPS (Tradewinds / custom port):
#    - PM2: pm2 start ecosystem.config.js --env production
#    - Required: TRUST_PROXY=false, NODE_DIRECT_HTTPS=true, SSL_* paths set

# ================================
# WILLIS PM2 DIRECT HTTPS EXAMPLE (recommended — no IIS proxy)
# ================================
# Copy into .env on C:\inetpub\wwwroot\pinnacle-einvoice-willis
#
# PORT=443
# NODE_DIRECT_HTTPS=true
# TRUST_PROXY=false
# SECURE_COOKIE=true
# COOKIE_DOMAIN=willis-einvoice.ddns.net
# SSL_KEY_PATH=./ssl/willis-einvoice.ddns.net.key
# SSL_CERT_PATH=./ssl/willis-einvoice.ddns.net.crt
# SSL_CA_PATH=./ssl/DigiCertCA.crt
#
# Stop IIS HTTPS :443 bindings first, then:
#   scripts\willis-pm2-setup.bat
# Or manually:
#   pm2 delete all
#   pm2 start ecosystem.config.js --env willis
#   pm2 save
#
# PM2 logs should show "Starting in HTTPS mode (direct Node SSL)" on port 443.

# ================================
# WILLIS IIS REVERSE PROXY EXAMPLE (optional — only if using IIS reverse proxy)
# ================================
# Copy these values into .env on C:\inetpub\wwwroot\pinnacle-einvoice-willis
# when deploying behind IIS (https://willis-einvoice.ddns.net).
#
# PORT=3000
# TRUST_PROXY=true
# NODE_DIRECT_HTTPS=false
# SECURE_COOKIE=true
# COOKIE_DOMAIN=willis-einvoice.ddns.net
# FORCE_HTTPS=true
#
# After updating .env, restart with the IIS profile:
#   pm2 delete all
#   pm2 start ecosystem.config.js --env iis
#   pm2 save
#
# PM2 logs should show "Starting in HTTP mode (IIS/reverse proxy terminates TLS)".
# If logs say "HTTPS mode (direct Node SSL)", the wrong PM2 profile is active.
# Deploy: copy web.config.production to web.config (deploy-production.bat does this automatically).

# ================================
# DATABASE CONFIGURATION
# ================================
# Replace with your actual SQL Server connection details.
# The host in DATABASE_URL must be reachable from the machine running Node (PM2), not only from your PC.
# Use IP address or FQDN if the NetBIOS name (e.g. TRADEWIND) does not resolve on the app server.
# If you see Prisma P2024 (connection pool timeout), raise the pool on this URL, e.g. append:
#   ;connection_limit=20;pool_timeout=30
# (Inbound sync + session store share one Prisma pool; default limit is often 5.)
DATABASE_URL="sqlserver://YOUR_SERVER:1433;database=YOUR_DATABASE;user=YOUR_USER;password=YOUR_PASSWORD;trustServerCertificate=true;encrypt=true"
DB_HOST=YOUR_SERVER
DB_USER=YOUR_USER
DB_PASSWORD=YOUR_SECURE_PASSWORD
DB_NAME=YOUR_DATABASE

# ================================
# AUTHENTICATION & SESSION
# ================================
# Generate a strong, unique session secret (minimum 32 characters)
SESSION_SECRET="REPLACE_WITH_STRONG_RANDOM_SECRET_MINIMUM_32_CHARS"
SESSION_TIMEOUT=1800000
COOKIE_MAX_AGE=86400000
MAX_LOGIN_ATTEMPTS=3
LOGIN_LOCKOUT_DURATION=300000
LOGIN_CLEANUP_INTERVAL=60000
SECURE_COOKIE=true
TRUST_PROXY=true
NODE_DIRECT_HTTPS=false
# FORCE_HTTPS: redirect http → https using the same Host (including :port). Set PUBLIC_APP_HOST if Host is wrong behind a proxy.
FORCE_HTTPS=true
# PUBLIC_APP_HOST=willis-einvoice.ddns.net
# If HTTPS is not on default 443 (another app uses 443), set DISABLE_HSTS=true — HSTS can make browsers prefer https://host:443.
# DISABLE_HSTS=true
#
# Willis PM2 direct HTTPS: TRUST_PROXY=false, NODE_DIRECT_HTTPS=true, PORT=443, PM2 --env willis
# Willis IIS proxy (legacy): TRUST_PROXY=true, NODE_DIRECT_HTTPS=false, PORT=3000, PM2 --env iis
# Tradewinds direct HTTPS: TRUST_PROXY=false, NODE_DIRECT_HTTPS=true, SSL_* paths below, PM2 --env production
# SSL_KEY_PATH=C:\certs\your.key
# SSL_CERT_PATH=C:\certs\your-fullchain.crt
# SSL_CA_PATH=C:\certs\chain-only.ca-bundle
COOKIE_DOMAIN=willis-einvoice.ddns.net
COOKIE_PATH=/
SESSION_NAME=connect.sid

# ================================
# LHDN API CONFIGURATION
# ================================
# Production LHDN API endpoints
PROD_BASE_URL=https://api.myinvois.hasil.gov.my
PREPROD_BASE_URL=https://preprod-api.myinvois.hasil.gov.my
# WP_CONFIGURATION LHDN Settings (DB): productionUrl and middlewareUrl must target the same
# MyInvois host for /connect/token and /api/v1.0/* (mismatch causes 401 on documents/recent).

# MyInvois API Compliance Settings
MAX_INCREMENTAL_PAGES=50
MAX_FULL_SYNC_PAGES=200
DB_DOCUMENT_LIMIT=5000
MYINVOIS_STRICT_COMPLIANCE=true
MYINVOIS_MIN_DELAY=5000
MYINVOIS_USAGE_WARNINGS=true

# ================================
# CERTIFICATE CONFIGURATION
# ================================
# Secure paths to your certificates (outside web root)
PRIVATE_KEY_FILE_PATH=C:\secure\certificates\private_key.pem
PRIVATE_CERT_FILE_PATH=C:\secure\certificates\digital_certificate.p12
CERT_PASSWORD=YOUR_CERTIFICATE_PASSWORD

# Certificate details (replace with your actual certificate information)
X509SubjectName_VALUE='C=MY, OID.2.5.4.97=YOUR_COMPANY_ID, O=Your Company Name, CN=Your Company Name'
X509IssuerName_VALUE='C=MY, O=MSC Trustgate.com Sdn. Bhd., CN=Trustgate MPKI Individual Subscriber CA'
X509SerialNumber_VALUE=YOUR_CERTIFICATE_SERIAL_NUMBER

# ================================
# API SECURITY
# ================================
# Generate a strong API key
API_KEY=YOUR_SECURE_API_KEY_HERE

# Comma-separated list of allowed IP addresses
ALLOWED_IPS=192.168.1.1,10.0.0.1,YOUR_ALLOWED_IPS

# ================================
# PUPPETEER CONFIGURATION
# ================================
# Path to Chrome executable for PDF generation
PUPPETEER_CHROMIUM_EXECUTABLE_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe

# ================================
# LOGGING CONFIGURATION
# ================================
# Log levels: error, warn, info, debug
LOG_LEVEL=info
LOG_FILE_PATH=C:\logs\einvoice\application.log
LOG_MAX_SIZE=100M
LOG_MAX_FILES=10

# ================================
# SECURITY SETTINGS
# ================================
# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# CORS settings
CORS_ORIGIN=http://127.0.0.1:3000/
CORS_CREDENTIALS=true

# ================================
# PERFORMANCE SETTINGS
# ================================
# Memory limits
MAX_MEMORY_RESTART=1G
CLUSTER_INSTANCES=max

# ================================
# MONITORING & HEALTH CHECKS
# ================================
HEALTH_CHECK_ENDPOINT=/health
METRICS_ENDPOINT=/metrics
MONITORING_ENABLED=true

# ================================
# BACKUP & MAINTENANCE
# ================================
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
MAINTENANCE_MODE=false

# ================================
# EXTERNAL SERVICES
# ================================
# Email service configuration (if used)
SMTP_HOST=your-smtp-server.com
SMTP_PORT=587
SMTP_SECURE=true
SMTP_USER=your-email@yourdomain.com
SMTP_PASSWORD=your-email-password

# File storage configuration (if using external storage)
STORAGE_TYPE=local
STORAGE_PATH=C:\secure\storage\einvoice

# ================================
# PRISMA LOGGING
# ================================
# Empty or unset = errors only (recommended for production / PM2).
# Local debugging: PRISMA_LOG=query,warn
PRISMA_LOG=

# ================================
# DEVELOPMENT OVERRIDES
# ================================
# These should be false in production
DEBUG_MODE=false
EXCEL_DEBUG=false
VERBOSE_LOGGING=false
# Prisma client log levels (comma-separated). Empty = errors only. Example: query,warn
PRISMA_LOG=
ENABLE_SWAGGER=false

# ================================
# DEPLOYMENT INFORMATION
# ================================
DEPLOYMENT_DATE=YYYY-MM-DD
DEPLOYMENT_VERSION=3.1.14
DEPLOYMENT_ENVIRONMENT=production

# ================================
# INSTRUCTIONS FOR SETUP
# ================================
#
# 1. Replace ALL placeholder values above with actual production values
# 2. Generate strong, unique secrets for SESSION_SECRET and API_KEY
# 3. Ensure certificate files are in secure locations outside web root
# 4. Verify database connection details are correct
# 5. Set appropriate file permissions: chmod 600 .env
# 6. Test configuration before going live
# 7. Never share or commit this file to version control
#
# For generating secure secrets, you can use:
# - Node.js: require('crypto').randomBytes(32).toString('hex')
# - Online: https://www.allkeysgenerator.com/Random/Security-Encryption-Key-Generator.aspx
# - Command line: openssl rand -hex 32
#
# ================================
